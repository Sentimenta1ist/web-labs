{
  "ConnectionStrings": {
    "Db": "Data Source=srvsql2017\\italy;Initial Catalog=POC.PdfGallery;User ID=POCPdfGalleryUser;password=$POC.01"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8080" ],
    "ExposedHeaders": [ "Content-Disposition" ]
  },
  "ApiName": "PdfGallery API",
  "Authentication": {
    //"Type": "Windows",
    "Type": "JWT",
    "AuthSecret": "***REMOVED***"
  },
  "Profiler": {
    "Secret": "***REMOVED***"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Fatal",
        "System": "Fatal"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Db",
          "tableName": "logs_tb",
          "schemaName": "log",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "MessageTemplate", "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "Application",
                "DataType": "varchar",
                "DataLength": 50
              },
              {
                "ColumnName": "SourceContext",
                "DataType": "nvarchar",
                "DataLength": -1
              },
              {
                "ColumnName": "UserName",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "OperationId",
                "DataType": "uniqueidentifier"
              }
            ]
          }
        }
      }
    ]
  }
}
